{
    "name": "dillonsmart/tetherphp-core",
    "description": "The core framework files for TetherPHP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tetherphp",
        "framework",
        "adr"
    ],
    "autoload": {
        "psr-4": {
            "TetherPHP\\": "src/"
        },
        "files": [
            "src/framework/Helpers/GlobalFunctions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TetherPHP\\Tests\\": "tests/",
            "Commands\\": "tests/Fixtures/app/Commands/",
            "TetherPHP\\Tests\\Fixtures\\app\\Actions\\": "tests/Fixtures/app/Actions/"
        }
    },
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
